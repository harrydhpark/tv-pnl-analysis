{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.py",
      "**/*.xlsb",
      "**/*.xlsm",
      "**/*.xlsx",
      "**/*.csv",
      "**/*.txt",
      "scratch*/**",
      ".agents/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
